# Frontend Dockerfile (multi-stage build)
# Build argument for app name: portal, daily-focus, my-portfolio
ARG APP_NAME=portal

# Stage 1: Build
FROM node:20-alpine AS builder

ARG APP_NAME

# Build-time environment variables for Vite
# Use placeholders that will be replaced at container startup
ENV VITE_PORTAL_URL=__VITE_PORTAL_URL__
ENV VITE_DAILY_FOCUS_URL=__VITE_DAILY_FOCUS_URL__
ENV VITE_PORTFOLIO_URL=__VITE_PORTFOLIO_URL__
ENV VITE_API_URL=__VITE_API_URL__

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/
COPY frontend/packages/shared-ui/package.json ./frontend/packages/shared-ui/
COPY frontend/apps/${APP_NAME}/package.json ./frontend/apps/${APP_NAME}/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy tsconfig files (needed for TypeScript inheritance)
COPY frontend/tsconfig.json ./frontend/

# Copy source files
COPY frontend/packages/shared-ui/ ./frontend/packages/shared-ui/
COPY frontend/apps/${APP_NAME}/ ./frontend/apps/${APP_NAME}/

# Build shared-ui first
RUN pnpm --filter @trading-wizard/shared-ui build

# Build the app
RUN pnpm --filter ${APP_NAME} build

# Stage 2: Serve with nginx
FROM nginx:alpine

ARG APP_NAME

# Copy nginx config (use app-specific config if exists, otherwise default)
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/nginx-${APP_NAME}.conf* /tmp/

# Use app-specific nginx config if it exists
RUN if [ -f /tmp/nginx-${APP_NAME}.conf ]; then \
      cp /tmp/nginx-${APP_NAME}.conf /etc/nginx/conf.d/default.conf; \
    fi && rm -f /tmp/nginx-*.conf

# Copy built files
COPY --from=builder /app/frontend/apps/${APP_NAME}/dist /usr/share/nginx/html

# Copy entrypoint script for runtime env var injection
COPY deploy/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
